{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://freqtrade.io/loop-engineering/backtest-history",
  "title": "Freqtrade Backtest Result Schema",
  "description": "Schema for storing backtest run results in the loop engineering system",
  "type": "object",
  "required": [
    "strategy_name",
    "strategy_file",
    "git_commit",
    "run_at",
    "timeframe",
    "timerange",
    "data_source",
    "results",
    "status"
  ],
  "properties": {
    "strategy_name": {
      "type": "string",
      "description": "Name of the strategy that was backtested"
    },
    "strategy_file": {
      "type": "string",
      "description": "Path to the strategy file"
    },
    "git_commit": {
      "type": "string",
      "description": "Git commit hash at time of backtest"
    },
    "run_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when backtest was run"
    },
    "timeframe": {
      "type": "string",
      "description": "Trading timeframe (e.g., '5m', '1h', '1d')"
    },
    "timerange": {
      "type": "string",
      "description": "Backtest time range (e.g., '20230101-20231231')"
    },
    "pairs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of trading pairs tested"
    },
    "data_source": {
      "type": "string",
      "enum": ["binance", "gate", "offline-mock", "unknown"],
      "description": "Source of market data. IMPORTANT: Set to 'offline-mock' if Binance API returns 451 (GEO blocked)"
    },
    "results": {
      "type": "object",
      "required": ["total_trades", "win_rate", "profit_total"],
      "properties": {
        "total_trades": {
          "type": "integer",
          "minimum": 0
        },
        "win_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Win rate as decimal (0-1)"
        },
        "profit_mean": {
          "type": "number"
        },
        "profit_total": {
          "type": "number",
          "description": "Total profit percentage"
        },
        "max_drawdown": {
          "type": "number"
        },
        "sharp_ratio": {
          "type": "number"
        },
        "avg_trade_duration_minutes": {
          "type": "number"
        },
        "holding_avg": {
          "type": "number"
        }
      }
    },
    "vs_previous": {
      "type": "object",
      "properties": {
        "previous_run_id": {
          "type": "string"
        },
        "win_rate_delta": {
          "type": "number"
        },
        "profit_delta": {
          "type": "number"
        },
        "drawdown_delta": {
          "type": "number"
        },
        "trade_count_delta": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": ["improved", "degraded", "unchanged", "no_previous"]
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["success", "failed_api_blocked", "failed_no_data", "failed_error", "skipped_no_data"],
      "description": "Backtest run status"
    },
    "error_detail": {
      "type": "string",
      "description": "Error message if backtest failed"
    },
    "backtest_command": {
      "type": "string",
      "description": "Exact command used to run the backtest"
    },
    "backtest_output_file": {
      "type": "string",
      "description": "Path to raw backtest output JSON file"
    }
  }
}
